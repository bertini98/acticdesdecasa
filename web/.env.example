# Copia este archivo como .env.local y rellénalo. Nunca subas .env.local a GitHub.

# URL pública de la web (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: solo para el servidor (webhook y lista de espera)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Desarrolladores → Claves de API (empieza en modo prueba: sk_test_...)
STRIPE_SECRET_KEY=
# Stripe → Desarrolladores → Webhooks (o lo que imprime `stripe listen` en local)
STRIPE_WEBHOOK_SECRET=
# Los imprime scripts/stripe-setup.mjs
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_TRIMESTRAL=
STRIPE_PRICE_ANUAL=

# "true" para que Stripe calcule el IVA (requiere activar Stripe Tax)
STRIPE_AUTOMATIC_TAX=false
# "true" para exigir la casilla de condiciones en el pago (requiere la URL de condiciones en Stripe)
STRIPE_TERMS_CONSENT=false

# Mientras sea false, los botones de compra llevan a la lista de espera
NEXT_PUBLIC_SALES_OPEN=false
